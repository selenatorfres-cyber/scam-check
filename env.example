BOT_TOKEN=
API_ID=
API_HASH=
MTPROTO_SESSION=./data/sessions/account_b

# Master administrator. Only this Telegram user can add/remove admins.
OWNER_ID=123456789
# Optional initial admins, comma-separated. Owner is always included automatically.
ADMIN_IDS=

# Optional: configure in Telegram with /set_review_group and /set_main_channel
# REVIEW_GROUP_ID=-1001234567890
# MAIN_CHANNEL_ID=-1001234567890
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
DEFAULT_LOGO=./data/logos/default.png
TIMEZONE=Asia/Kolkata
